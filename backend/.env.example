# 数据库连接；本地开发默认 SQLite，团队部署用 Postgres
# DATABASE_URL=postgresql+psycopg://promptscope:promptscope@localhost:5433/promptscope

# 是否开放自助注册（/login 页面的注册入口 + POST /api/auth/register）；关闭后仅能由已有账号登录，新账号需管理员用 create_user 脚本创建
# AUTH_ALLOW_REGISTRATION=true

# 会话 Cookie 是否加 Secure 标记；部署在 HTTPS 之后请设为 true，否则浏览器可能拒收该 Cookie
# SECURE_COOKIES=false

# 登录会话有效期（天）
# SESSION_TTL_DAYS=30

# provider api_key 落库加密密钥（Fernet）；生产必须显式设置，未设置时自动生成到
# backend/db/.encryption_key，仅适合本地开发。生成方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PROMPTSCOPE_ENCRYPTION_KEY=
